# Copie este arquivo para .env e preencha os valores antes de subir o ambiente local.
# Nunca versione o arquivo .env real.

# Banco de dados PostgreSQL (Docker Compose)
POSTGRES_DB=uniflow
POSTGRES_USER=uniflow
POSTGRES_PASSWORD=troque_por_uma_senha_forte_local
POSTGRES_PORT=5432

# Datasource Spring Boot
DB_URL=jdbc:postgresql://localhost:5432/uniflow
DB_USERNAME=uniflow
DB_PASSWORD=troque_por_uma_senha_forte_local

# Perfil ativo e porta da API (dev, test, prod)
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# OpenAPI / Swagger em producao (desabilitado por padrao)
API_DOCS_ENABLED=false
SWAGGER_ENABLED=false

# Seguranca JWT (use chave aleatoria com pelo menos 32 bytes)
JWT_SECRET=troque_por_um_segredo_jwt_forte_com_minimo_32_bytes
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS para uniflow-frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173
