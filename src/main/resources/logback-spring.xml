<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<include resource="org/springframework/boot/logging/logback/defaults.xml"/>

	<conversionRule conversionWord="maskedMsg"
					class="com.uniflow.common.filter.SensitiveDataMaskingConverter"/>

	<springProfile name="!prod">
		<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
			<encoder>
				<pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z', UTC} %-5level [%thread] %logger{36} [requestId=%X{requestId:-none}] - %maskedMsg%n%wEx</pattern>
				<charset>UTF-8</charset>
			</encoder>
		</appender>

		<root level="INFO">
			<appender-ref ref="CONSOLE"/>
		</root>
	</springProfile>

	<springProfile name="prod">
		<appender name="CONSOLE_STRUCTURED" class="ch.qos.logback.core.ConsoleAppender">
			<encoder>
				<pattern>timestamp=%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z', UTC} level=%-5level service=uniflow-backend thread=%thread logger=%logger{36} requestId=%X{requestId:-none} method=%X{httpMethod:-none} path=%X{requestPath:-none} message=[%maskedMsg]%n%xEx{10}</pattern>
				<charset>UTF-8</charset>
			</encoder>
		</appender>

		<root level="INFO">
			<appender-ref ref="CONSOLE_STRUCTURED"/>
		</root>
	</springProfile>
</configuration>
